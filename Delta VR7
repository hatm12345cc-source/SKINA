<script>
    function toggleMenu() {
        const main = document.getElementById('main-page');
        const hacks = document.getElementById('hacks-page');
        if (main.classList.contains('active')) {
            main.classList.remove('active');
            hacks.classList.add('active');
        } else {
            hacks.classList.remove('active');
            main.classList.add('active');
        }
    }
</script>

</body>
