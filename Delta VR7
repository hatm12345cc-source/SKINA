    <title>VN7 | أبوعتب للبرمجة والتكنولوجيا</title>
    <style>
        :root {
            --bg-dark: #050507;
            --card-bg: #0f0f13;
            --accent-purple: #8e2de2;
            --accent-blue: #00e5ff;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            margin: 0; padding: 0;
            text-align: center;
        }

        header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 15px 5%; background: #000;
            border-bottom: 2px solid var(--accent-purple);
            position: sticky; top: 0; z-index: 1000;
        }

        .menu-toggle {
            width: 45px; height: 45px;
            cursor: pointer; border-radius: 12px;
            border: 1px solid var(--accent-purple);
        }

        .logo { font-size: 26px; font-weight: bold; }
        .logo span { color: var(--accent-purple); }

        .container { max-width: 600px; margin: 20px auto; padding: 15px; }

        .page-section { display: none; }
        .active { display: block; animation: fadeIn 0.4s; }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .hero-btn {
            background: #5865F2; padding: 20px; border-radius: 20px;
            text-align: center; text-decoration: none; color: white;
            font-weight: bold; display: flex; align-items: center; justify-content: center;
            margin-bottom: 20px; font-size: 18px;
        }

        .section-title {
            font-size: 20px; color: var(--accent-blue); margin: 30px 0 15px;
            text-align: right; padding-right: 15px; border-right: 5px solid var(--accent-purple);
        }

        .card {
            background: var(--card-bg); border-radius: 22px; padding: 15px;
            text-align: right; border: 1px solid #1f1f27; margin-bottom: 15px;
        }

        .card img { width: 100%; border-radius: 15px; margin-bottom: 12px; border: 1px solid #333; }

        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }

        .btn-sm {
            display: block; text-align: center; padding: 12px; border-radius: 12px;
            text-decoration: none; color: white; font-weight: bold; font-size: 12px; margin-top: 8px;
        }

        footer { padding: 30px; color: #555; font-size: 12px; }

        @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

